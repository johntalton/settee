{
  "name": "@johntalton/canape",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "start": "node --permission --no-warnings --allow-net  --allow-worker --allow-fs-read=package.json --allow-fs-read=./certificates/* --allow-fs-read=../settee/* --allow-fs-read=../node_modules/* --allow-fs-read=./src --allow-fs-read=.env --allow-fs-read=/Volumes/UNTITLED/* --allow-fs-write=/Volumes/UNTITLED/* --allow-fs-read=../data --allow-fs-write=../data/*  --env-file=.env ./src/index.js",
    "start-weak": "node  --env-file=.env ./src/index.js",
    "flame": "clinic flame -- node --env-file=.env ./src/index.js",
    "heap": "clinic heapprofiler -- node --env-file=.env ./src/index.js",
    "doctor": "clinic doctor -- node --env-file=.env ./src/index.js",
    "lint": "biome check ."
  },
  "dependencies": {
    "@johntalton/http-util": "^9.0.0",
    "@johntalton/http-core": "^1.4.2",
    "@johntalton/settee": "^1.0.0",
    "@johntalton/sse-util": "^1.0.0"
  }
}
